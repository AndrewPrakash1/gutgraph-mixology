# Copy to .env in this folder (gutgraph-mixology/). Never commit .env.
# .env is gitignored; this template is safe to commit — keep it key-free.

# --- LLM agents (parliament) — Command Code key from https://commandcode.ai/settings/keys ---
COMMANDCODE_API_KEY=
# COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
# COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
# LLM_PROVIDER=commandcode

# Or DeepSeek / OpenRouter directly (whichever key is set wins):
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1
# LLM_PROVIDER=commandcode        # commandcode | deepseek | openrouter — optional force
# LLM_MAX_TOKENS=200              # default 200 on commandcode, 90 otherwise
# LLM_TIMEOUT=30

# --- FoodoScope (RecipeDB / FlavorDB) — campus network ---
FOODOSCOPE_API_KEY=
FOODOSCOPE_BASE_URL=http://cosylab.iiitd.edu.in:6969
